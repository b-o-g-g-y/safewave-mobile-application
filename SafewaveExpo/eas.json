{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "development-consumer": {
      "extends": "development",
      "env": {
        "APP_VARIANT": "consumer"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview-consumer": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "consumer"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "production-consumer": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "consumer"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "VXLM9VZK85"
      }
    },
    "production-consumer": {
      "ios": {
        "appleTeamId": "VXLM9VZK85"
      }
    }
  }
}
