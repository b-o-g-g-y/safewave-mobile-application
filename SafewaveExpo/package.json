{
  "name": "safewaveexpo",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:business": "APP_VARIANT=business expo start",
    "start:consumer": "APP_VARIANT=consumer expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:business": "APP_VARIANT=business expo prebuild --clean",
    "prebuild:consumer": "APP_VARIANT=consumer expo prebuild --clean",
    "build:business:ios": "eas build --profile production --platform ios",
    "build:business:android": "eas build --profile production --platform android",
    "build:consumer:ios": "eas build --profile production-consumer --platform ios",
    "build:consumer:android": "eas build --profile production-consumer --platform android",
    "submit:business": "eas submit --profile production",
    "submit:consumer": "eas submit --profile production-consumer",
    "postinstall": "npx patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "23.7.0",
    "@react-native-firebase/auth": "23.7.0",
    "@react-native-firebase/firestore": "23.7.0",
    "@react-native-firebase/functions": "23.7.0",
    "@react-native-firebase/messaging": "23.7.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/bottom-tabs": "^7.9.1",
    "@react-navigation/native": "^7.1.27",
    "@react-navigation/native-stack": "^7.9.1",
    "expo": "~54.0.31",
    "expo-apple-authentication": "^8.0.8",
    "expo-background-fetch": "^14.0.9",
    "expo-build-properties": "^1.0.10",
    "expo-dev-client": "^6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "^6.0.9",
    "expo-task-manager": "^14.0.9",
    "prop-types": "^15.8.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.5.0",
    "react-native-installed-apps": "^0.0.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
